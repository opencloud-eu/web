      <div class="flex flex-col items-center md:items-start gap-4">
        <div class="text-center md:text-left">
          <div>Profile picture</div>
          <div class="text-sm text-role-on-surface-variant">Max. 10MB, JPG, PNG</div>
        </div>
        <div class="oc-button-group"><button type="button" class="oc-button-secondary oc-button-outline oc-button-secondary-outline gap-2 justify-center text-sm min-h-3 oc-button cursor-pointer disabled:opacity-60 disabled:cursor-default">
