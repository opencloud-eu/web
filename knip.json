{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["packages/web-pkg/src/editor/styles/*.css"],
  "ignoreUnresolved": ["tests/unit/config/vitest.init.ts"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreIssues": {
    "packages/design-system/src/**": ["enumMembers", "duplicates"],
    "packages/web-pkg/src/**": ["enumMembers", "duplicates"],
    "packages/web-client/src/**": ["enumMembers", "duplicates"]
  },
  "vitest": {
    "config": ["tests/unit/config/vitest.config.ts"]
  },
  "workspaces": {
    ".": {
      "vite": {
        "config": []
      },
      "entry": [
        "vite.config.ts",
        "vite.config.common.ts",
        "gettext.config.cjs",
        "release-config.ts",
        "polyfills/*.js",
        "dev/vite-plugins/*.ts",
        "tests/unit/config/vitest.init.ts",
        "tests/unit/stubs/*.ts"
      ]
    },
    "tests/e2e": {
      "entry": ["steps/**/*.ts", "support/**/*.ts", "environment/**/*.ts", "scripts/**/*.{ts,mjs}"]
    },
    "packages/design-system": {
      "entry": ["docs/.vitepress/**/*.{ts,vue}", "docs/**/*.vue"]
    },
    "services/yjs": {
      "entry": ["src/healthcheck.ts"]
    },
    "packages/extension-sdk": {
      "entry": ["src/index.ts", "src/tailwind.css"]
    },
    "packages/web-pkg": {
      "ignoreDependencies": ["@tiptap/extension-node-range", "@vue/shared"]
    }
  }
}
